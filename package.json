{
  "name": "bingx-mcp",
  "version": "1.0.0",
  "description": "MCP server for BingX USDT-M perpetual futures (balance, positions, orders, history, trading)",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "bingx-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "scan": "node scripts/scan.js",
    "scan:send": "node --env-file=.env scripts/scan.js --send",
    "events": "node --env-file=.env scripts/events.js",
    "alerts": "node --env-file=.env scripts/alerts.js",
    "journal": "node --env-file=.env scripts/journal.js",
    "vk:users": "node --env-file=.env scripts/vk-users.js",
    "signal-stats": "node --env-file=.env scripts/signal-stats.js",
    "top": "node --env-file=.env scripts/top.js",
    "bot": "node --env-file=.env scripts/bot.js",
    "cleanup": "node scripts/cleanup.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
